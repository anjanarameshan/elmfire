&INPUTS
FUELS_AND_TOPOGRAPHY_DIRECTORY = './inputs'
LANDSCAPE_FILENAME             = 'landscape'
ADJ_FILENAME                   = 'adj'
PHI_FILENAME                   = 'phi'
DT_METEOROLOGY                 = 3600.0
WEATHER_DIRECTORY              = './inputs'
WS_FILENAME                    = 'ws'
WD_FILENAME                    = 'wd'
M1_FILENAME                    = 'm1'
M10_FILENAME                   = 'm10'
M100_FILENAME                  = 'm100'
USE_CONSTANT_LH                = .FALSE.
MLH_FILENAME                   = 'lh'
USE_CONSTANT_LW                = .FALSE.
MLW_FILENAME                   = 'lw'
USE_BARRIERS                   = .TRUE.   ! OSM roads + rivers, width in m
BARRIER_FILENAME               = 'barrier'
/

&OUTPUTS
OUTPUTS_DIRECTORY    = './outputs'
DTDUMP = 3600
DUMP_FLIN            = .TRUE.
DUMP_SPREAD_RATE     = .TRUE.
DUMP_TIME_OF_ARRIVAL = .TRUE.
DUMP_SURFACE_FIRE      = .TRUE.   ! hourly burned-area map (kept even if a run stops early)
DUMP_TRANSIENT_ACREAGE = .TRUE.   ! acres at every dump -> outputs/acres_*.csv
CONVERT_TO_GEOTIFF   = .TRUE.
DUMP_EMBER_IGNITION  = .TRUE.
DUMP_EMBER_FLUX      = .TRUE.
/

&TIME_CONTROL
SIMULATION_DT    = 30.0   ! 1 s trips the "stalled" check on slow litter fires
TARGET_CFL       = 0.4   ! ELMFIRE default; tutorial 3 used 0.2 (2x more steps)
SIMULATION_TSTOP = 176400
/

&SIMULATOR
NUM_IGNITIONS = 0
X_IGN(1)      =
Y_IGN(1)      =
T_IGN(1)      =
X_IGN(2)      =
Y_IGN(2)      =
T_IGN(2)      =
/

&MISCELLANEOUS
PATH_TO_GDAL                   = 'auto'
SCRATCH                        = './scratch'
/
&SPOTTING
! Eulerian ember model, as in the Gatlinburg structure runs (guide 1.11): embers per MW of fire,
! Sardoy/Himoto distances, Eulerian accumulation, physical ignition (vegetation ignites once embers land)
ENABLE_SPOTTING                          = .TRUE.
ENABLE_SURFACE_FIRE_SPOTTING             = .TRUE.
USE_SUPERSEDED_SPOTTING                  = .FALSE.
GENERATION_MODEL                         = 'PER-MW'
SPOTTING_DISTANCE_MODEL                  = 'EMPIRICAL'
ACCUMULATION_MODEL                       = 'EULERIAN'
IGNITION_MODEL                           = 'PHYSICAL'
DIFF_WILDLAND_IGNITION                   = .TRUE.
CRITICAL_SPOTTING_FIRELINE_INTENSITY(:)  = 0.
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT     = 100.
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT_MAX = 100.
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT_MIN = 100.
TAU_EMBERGEN                             = 10.0
P_EPS                                    = 0.001
/

&MONTE_CARLO
SEED = 2024
/
